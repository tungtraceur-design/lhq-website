# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reckless trial fonts (not licensed for distribution); commit licensed files instead
/src/app/fonts/reckless/

# Swear Banner demo files for local preview; commit the licensed web fonts instead
/src/app/fonts/swear/

# Same font files, served locally. A GitHub Pages build falls back when they are absent.
/public/fonts/

# design scratch files
/.cursor/font-demos/
/.cursor/logo/
